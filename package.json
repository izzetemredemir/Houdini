{
  "name": "houdini",
  "version": "1.0.0",
  "description": "AI-readable wallet profiles stored on 0G - bringing the llms.txt standard on-chain",
  "author": "Houdini Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "web3",
    "ai",
    "llms.txt",
    "0g-storage",
    "wallet-identity",
    "nft",
    "ethereum",
    "octav",
    "erc7730",
    "ledger",
    "blockchain",
    "decentralized-storage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/houdini.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/houdini/issues"
  },
  "homepage": "https://github.com/yourusername/houdini#readme",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "vite",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" --names \"frontend,backend\" --prefix-colors \"cyan,magenta\"",
    "stop": "lsof -ti:5175,7342 | xargs kill -9 2>/dev/null || true",
    "stop:frontend": "lsof -ti:5175 | xargs kill -9 2>/dev/null || true",
    "stop:backend": "lsof -ti:7342 | xargs kill -9 2>/dev/null || true",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "hardhat": "hardhat --config blockchain/hardhat.config.ts",
    "test:sol": "npm run hardhat test solidity",
    "test:node": "npm run hardhat test nodejs",
    "deploy:local": "npm run hardhat ignition deploy blockchain/ignition/modules/Counter.ts"
  },
  "dependencies": {
    "@0glabs/0g-ts-sdk": "^0.3.3",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@tanstack/react-query": "^5.90.10",
    "ethers": "6.13.1",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.0",
    "react-loading-skeleton": "^3.5.0",
    "recharts": "^3.4.1",
    "wagmi": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nomicfoundation/hardhat-ignition": "^3.0.5",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.5",
    "@nomicfoundation/hardhat-keystore": "^3.0.3",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.7",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@nomicfoundation/hardhat-verify": "^3.0.7",
    "@nomicfoundation/hardhat-viem": "^3.0.1",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.4",
    "@nomicfoundation/ignition-core": "^3.0.5",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "hardhat": "^3.0.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "viem": "^2.39.3",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}

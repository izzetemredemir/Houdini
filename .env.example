# ==============================================================================
# Houdini Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Wallet Connection
# ------------------------------------------------------------------------------

# WalletConnect Cloud project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ------------------------------------------------------------------------------
# Octav API Configuration (Optional)
# ------------------------------------------------------------------------------

# Get your API key from https://data.octav.fi/
# Note: Requests are routed through corsproxy.io to bypass CORS restrictions
VITE_OCTAV_API_KEY=your_octav_api_key_here

# ------------------------------------------------------------------------------
# 0G Storage Configuration
# ------------------------------------------------------------------------------

# 0G Network RPC Endpoints (Testnet)
VITE_OG_EVM_RPC_URL=https://evmrpc-testnet.0g.ai
VITE_OG_INDEXER_RPC_URL=https://indexer-storage-testnet-turbo.0g.ai

# Note: Users need OG tokens in their wallet to pay for storage fees
# 0G Storage uses a two-lane architecture:
# - EVM RPC: For blockchain transactions and fee payment
# - Indexer RPC: For file storage and retrieval
